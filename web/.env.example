# 이 파일을 복사해서 `.env`로 만들고 값을 채우세요.
#   cp .env.example .env
#
# `.env`는 커밋되지 않습니다(.gitignore). `.env.example`만 저장소에 올라갑니다.
#
# 값은 Supabase 대시보드 > Project Settings > API 에서 가져옵니다.

# 프로젝트 URL. 예: https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# publishable / anon 키.
#
# ⚠️ NEXT_PUBLIC_ 접두사가 붙어 있으므로 이 값은 브라우저 코드에 그대로 박힙니다.
#    그래도 되는 키입니다. KPI 기록은 브라우저에서 일어나므로 다른 방법이 없고,
#    이 키로 할 수 있는 일은 supabase/schema.sql의 RLS 정책이 허용한 것뿐입니다.
#    지금 허용된 것은 "기록 남기기(insert)" 하나뿐이고, 읽기는 막혀 있습니다.
#
# ⚠️ service_role / secret 키는 절대 여기 넣지 마세요. 그 키는 RLS를 통째로 무시합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
